# Lumina – Environment Configuration
# Copy this file to .env and fill in your values.

# ── OpenAI (optional) ──────────────────────────────────────────────────────
# Leave blank to use the built-in keyword fallback classifier.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Area (defaults: Bengaluru MG Road) ────────────────────────────────────
CENTER_LAT=12.9757
CENTER_LON=77.6011
GRAPH_RADIUS_M=3200

# Default start / end for the demo
DEFAULT_START_LAT=12.9820
DEFAULT_START_LON=77.5933
DEFAULT_END_LAT=12.9687
DEFAULT_END_LON=77.6104

# ── Routing weights ────────────────────────────────────────────────────────
ALPHA_VIS=50
ALPHA_PRACTICAL=15
ALPHA_FAST=0

# ── Escort / navigation ────────────────────────────────────────────────────
ESCORT_THRESHOLD=30
POLL_NORMAL_S=15
POLL_ESCORT_S=3
EYES_UP_DELAY_S=30

# Optional webhook for contact notification (POST with JSON payload)
WEBHOOK_URL=
